<%- include('includes/head') %>
    <%- include('includes/nav') %>

        <div class="container">
            <div class="row">
                <div class="col-lg-2"></div>

                <div class="col-lg-8 my-3">
                    <h1 class="text-center">Agendamento</h1>
                    <% if (contato.id) { %>
                        <p class="text-center lead">Editar agendamento.</p>
                    <% } else { %>
                        <p class="text-center lead">Criar novo agendamento.</p>
                    <% } %>
                    

                    <%- include('includes/messages') %>

                    <% if (contato.id) { %>
                        <form action="/contato/edit/<%= contato._id %>" class="col-lg shadow p-5 bg-white rounded form-agendamento" method="POST">
                    <% } else { %>
                        <form action="/contato/register" class="col-lg shadow p-5 bg-white rounded form-agendamento" method="POST">
                    <% } %>
                            <input type="hidden" name="_csrf" value=<%= csrfToken %>>
                            <div class="form-group">
                                <label>Nome completo</label>
                                <input value="<%= contato.nome %>" type="text" class="form-control" name="nome" placeholder="Digite seu nome">
                                <p class="text-danger nome-error"></p>
                            </div>
                            <div class="form-group">
                                <label>Telefone</label>
                                <input value="<%= contato.telefone %>" type="tel" class="form-control" name="telefone" placeholder="Digite seu telefone">
                                <p class="text-danger tel-error"></p>
                            </div>
                            <div class="form-group">
                                <label>Serviço</label>
                                <select value="<%= contato.servico %>" class="form-control" name="servico">
                                    <option value="" disabled selected>Escolha o serviço desejado</option>
                                    <option value="Corte">Corte</option>
                                    <option value="Barba">Barba</option>
                                    <option value="Completo">Corte + Barba</option>
                                </select>
                                <p class="text-danger servico-error"></p>
                            </div>
                            <div class="form-group">
                                <label>Data de agendamento</label>
                                <input value="<%= contato.data %>" type="datetime-local" class="form-control" name="data">
                                <p class="text-danger data-error"></p>
                            </div>

                    <% if (contato.id) { %>
                        <button type="submit" class="btn btn-primary text-white">Alterar</button>
                    <% } else { %>
                        <button type="submit" class="btn btn-primary text-white">Agendar</button>
                    <% } %>
                        </form>
                </div>

                <div class="col-lg-2"></div>
            </div>
        </div>

        <%- include('includes/footer') %>