<%- include('includes/head') %>
<%- include('includes/nav') %>

<div class="container">
    <div class="row">
        <div class="col-lg-2g"></div>

        <div class="col-lg-8 my-3">
            <h1 class="text-center">Agendamentos</h1>
            <%- include('includes/messages') %>
            <% if(!user) { %>
            <p class="text-center alert alert-danger">Você precisa fazer login para agendar horários.</p>
           <% } else if(agendamentos.length > 0) { %>
            <div class="responsive-table shadow">
                <table class="table my-3">
                    <% agendamentos.forEach(agendamento => { %>
                    <tr>
                        <td><%= agendamento.nome %></td>
                        <td><%= agendamento.telefone.replace(/^(\d{2})(\d{5})(\d{4})$/, "($1) $2-$3") %></td>
                        <td><%= agendamento.servico %></td>
                        <td><%= agendamento.data %></td>
                        <td><a href="/contato/index/<%= agendamento._id %>">Editar</a></td>
                        <td><a class="text-danger" href="/contato/delete/<%= agendamento._id %>">Excluir</a></td>
                    </tr>
                    <% }); %>
                </table>
            </div>
            <% } else { %> 
                 <p class="text-center lead">Não existem serviços agendados.</p>
            <% } %>   
        </div>

        <div class="col-lg-2"></div>
    </div>
</div>

<%- include('includes/footer') %>
