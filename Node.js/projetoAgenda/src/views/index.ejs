<%- include('includes/head') %>
<%- include('includes/nav') %>

<div class="container">
    <div class="row">
        <div class="col-lg-2"></div>

        <div class="col-lg-8 my-3 d-flex flex-column">
            <h1 class="text-center"><span class="border-bottom border-primary">Agendamentos</span></h1>
            <%- include('includes/messages') %>
            <% if(!user) { %>
            <p class="text-center alert alert-danger">Você precisa fazer login para agendar horários.</p>
           <% } else if(agendamentos.length > 0) { %>
            <div class="responsive-table">
                <table class="table shadow my-3">
                    <% agendamentos.forEach(agendamento => { %>
                    <tr class="">
                        <td class="px-2 py-4"><%= agendamento.nome %></td>
                        <td class="px-2 py-4"><%= agendamento.telefone.replace(/^(\d{2})(\d{5})(\d{4})$/, "($1) $2-$3") %></td>
                        <td class="px-2 py-4"><%= agendamento.servico %></td>
                        <td class="px-2 py-4"><%= agendamento.data %></td>
                        <td class="px-2 py-4"><a href="/contato/index/<%= agendamento._id %>">Editar</a></td>
                        <td class="px-2 py-4"><a class="text-danger" href="/contato/delete/<%= agendamento._id %>">Excluir</a></td>
                    </tr>
                    <% }); %>
                </table>
            </div>
            <% } else { %> 
                 <p class="text-center lead">Não existem serviços agendados.</p>
                 <a href="/contato/index" class="mx-auto text-center lead btn btn-primary">Agendar</a>
            <% } %>   
        </div>

        <div class="col-lg-2"></div>
    </div>
</div>

<%- include('includes/footer') %>
