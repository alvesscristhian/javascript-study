<%- include('includes/head') %>
<%- include('includes/nav') %>

<div class="container">
    <div class="row">
        <div class="col-lg-2"></div>

        <div class="col-lg-8 my-3">
            <h1 class="text-center">Acesse sua conta</h1>
            <p class="text-center lead mb-5">Faça login ou crie sua conta abaixo</p>
            
            <%- include('includes/messages') %>

            <div class="row">
            
                <div class="col-lg shadow p-3 mb-5 bg-white rounded mx-3">
                    <h4 class="text-center">Cadastrar</h4>
                    <p>Se você ainda não cadastrou uma conta, preencha seus dados abaixo:</p>

                    <form class="form-cadastro" action="/login/register" method="POST">
                        <input type="hidden" name="_csrf" value=<%= csrfToken %>>
                        <div class="form-group">
                            <label>Seu usuário</label>
                            <input type="text" class="form-control" name="usuario" placeholder="Digite seu usuario">
                            <p class="text-danger h6 erro-user font"></p>
                        </div>
                        <div class="form-group">
                            <label>Seu e-mail</label>
                            <input type="email" class="form-control" name="email" placeholder="Digite seu e-mail">
                            <p class="text-danger h6 erro-email font"></p>
                        </div>
                        <div class="form-group">
                            <label>Sua senha</label>
                            <input type="password" class="form-control" name="password" placeholder="Digite sua senha">
                            <p class="text-danger h6 erro-password font"></p>
                        </div>
                        <button type="submit" class="btn btn-primary text-white">Cadastrar</button>
                    </form>
                </div>

                <div class="col-lg shadow p-3 mb-5 bg-white rounded mx-3">
                    <h4 class="text-center">Entrar</h4>
                    <p>Se você já tem uma conta, faça login abaixo:</p>

                    <form class="form-login" action="/login/login" method="POST">
                        <input type="hidden" name="_csrf" value=<%= csrfToken %>>

                        <div class="form-group">
                            <label>Seu e-mail</label>
                            <p class="text-danger h6 erro-msg font"></p>
                            <input type="email" class="form-control" name="email" placeholder="Digite seu e-mail">
                            <p class="text-danger h6 login-email font"></p>
                        </div>
                        <div class="form-group">
                            <label>Sua senha</label>
                            <p class="text-danger h6 erro-msg font"></p>
                            <input type="password" class="form-control" name="password" placeholder="Digite sua senha">
                            <p class="text-danger h6 login-password font"></p>

                        </div>
                        <button type="submit" class="btn btn-primary text-white">Entrar</button>
                    </form>
                </div>
            
            </div>
        </div>

        <div class="col-lg-2"></div>
    </div>
</div>

<%- include('includes/footer') %>
